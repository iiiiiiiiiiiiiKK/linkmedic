# LinkMedic — environment variables
#
# Copy to `.env` for the Node server, or set these as Cloudflare Pages
# environment variables / wrangler [vars]. None of them are secrets: the app
# ships with sane defaults and never needs an API key.

# ---------------------------------------------------------------------------
# Cloudflare Pages deployment
# ---------------------------------------------------------------------------

# Per-IP diagnoses allowed per rolling minute. Default: 20.
LINKMEDIC_RATE_LIMIT=20

# Hard ceiling for the "broken link" sample size (0 disables link checking
# entirely for every request). Default: 25.
LINKMEDIC_MAX_LINKS=25

# KV namespace bound as LINKMEDIC_KV — stores the rate-limit counters.
# On Cloudflare this is declared in wrangler.toml, not here. Leave empty locally:
# without it the API still works and /api/health reports rateLimitEnforced=false.
# LINKMEDIC_KV_ID=012460fba616479a846a011f3400c234

# ---------------------------------------------------------------------------
# Self-hosted Node server (server/index.mjs)
# ---------------------------------------------------------------------------

# Bind address and port for the bundled server. Defaults: 127.0.0.1:8787
HOST=127.0.0.1
PORT=8787

# Wall-clock budget for one full diagnosis, in milliseconds. Default: 30000
LINKMEDIC_BUDGET_MS=30000

# ---------------------------------------------------------------------------
# Development only
# ---------------------------------------------------------------------------

# Where `vite dev` proxies /api/* (the local wrangler or node server).
# Default: http://127.0.0.1:8788
# LINKMEDIC_API=http://127.0.0.1:8788

# Absolute path to a Chromium/Chrome binary for the Playwright suites.
# Auto-detected on Windows/macOS/Linux if unset.
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
